# EmailJS — formulaire de contact (https://dashboard.emailjs.com)
# Copier ce fichier en `.env` et renseigner les trois valeurs.
# Sans elles, le formulaire affiche un message d'indisponibilite au lieu d'echouer en silence.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
